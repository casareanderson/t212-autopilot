# Demo until your own numbers say otherwise. See the README.
T212_MODE=demo

# HTTP Basic: the key is the username, the secret is the password.
# T212 -> Settings -> API (Beta). Generate a key for the account you named above:
# a live key returns 401 against the demo host and vice versa.
T212_KEY=
T212_SECRET=

# The ceiling on everything this tool controls, in GBP.
AUTOPILOT_STAKE_GBP=100

# 90% accumulation / 10% signal-following.
AUTOPILOT_SAFE_SHARE=0.90
AUTOPILOT_SAFE_TICKERS=VUAG_EQ,VWRP_EQ,ISF_EQ
AUTOPILOT_MAX_RISK_POSITIONS=4

# A pick below this recorded hit rate is not bought.
AUTOPILOT_MIN_HIT_RATE=0.60

# Optional. Without it the picks keep their incoming order.
GROK_API_KEY=
GROK_MODEL=grok-4-latest
